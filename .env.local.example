# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# MERCADO PAGO
# ============================================================
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-...

# ============================================================
# RESEND (email transaccional)
# ============================================================
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@mc-importados.xyz
RESEND_FROM_NAME=CM Importados

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=https://www.mc-importados.xyz
NEXT_PUBLIC_TIENDA_NOMBRE=CM Importados

# ============================================================
# SEGURIDAD
# ============================================================
REVALIDATE_SECRET_TOKEN=genera_con_openssl_rand_base64_32

# ============================================================
# TAWK.TO (chat — opcional)
# ============================================================
NEXT_PUBLIC_TAWKTO_PROPERTY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_TAWKTO_WIDGET_ID=default

# ============================================================
# WHATSAPP FLOTANTE
# ============================================================
NEXT_PUBLIC_WHATSAPP_NUMBER=5491166585257
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola! Me interesa hacer un pedido

# ============================================================
# MANTENIMIENTO (fallback si no está en DB)
# ============================================================
MAINTENANCE_MODE=false

# ============================================================
# SEGURIDAD WEBHOOK (Mercado Pago)
# ============================================================
# Obtenerla en: Tus integraciones → tu app → Webhooks → "Clave secreta"
# (NO es el Access Token, es un valor distinto que MP genera al
# configurar la URL de notificaciones)
MERCADOPAGO_WEBHOOK_SECRET=

# Email del administrador (para notificaciones de nuevos pedidos, comprobantes, etc.)
# Si no se configura, se usa RESEND_FROM_EMAIL como fallback
ADMIN_EMAIL=

# ============================================================
# WEB PUSH — Notificaciones push al admin (MÓDULO 5)
# ============================================================
# Generar las claves VAPID corriendo:
#   npx web-push generate-vapid-keys
# Pegar los resultados acá y en Vercel → Environment Variables.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
# La clave pública también se necesita en el cliente (prefijo NEXT_PUBLIC_):
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ============================================================
# SEO — Google Search Console y Facebook
# ============================================================
# Google Search Console → Configuración → Verificación del dominio → etiqueta HTML
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Facebook Business → Administrador de negocios → Configuración → Dominio
NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=

# Facebook for Developers → tu app → Configuración → ID de la app
NEXT_PUBLIC_FB_APP_ID=

# Facebook Pixel → opcional, para rastrear conversiones
NEXT_PUBLIC_FB_PIXEL_ID=
