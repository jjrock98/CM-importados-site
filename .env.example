# ══════════════════════════════════════════════════════════════════════
#  MC Importados — variables de entorno
#
#  Uso local:   copiar este archivo a `.env.local` y completar los valores
#               (Windows: copy .env.example .env.local)
#  Producción:  cargarlas en Vercel → Project Settings → Environment Variables
#
#  Las OBLIGATORIAS están activas. Las opcionales están comentadas con `# `:
#  descomentá solo las que vayas a usar (una variable vacía NO es lo mismo
#  que una variable ausente: algunas usan un valor por defecto solo si falta).
#
#  NUNCA subas `.env.local` al repositorio. Este archivo solo tiene los
#  NOMBRES de las variables, sin valores.
#  Las que empiezan con NEXT_PUBLIC_ quedan visibles en el navegador.
# ══════════════════════════════════════════════════════════════════════


# ─── OBLIGATORIAS ─────────────────────────────────────────────────────

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # solo servidor, nunca exponer

# Resend (emails)
RESEND_API_KEY=                     # empieza con re_
RESEND_FROM_EMAIL=                  # remitente verificado en Resend

# URL pública del sitio, sin barra final (ej: https://www.midominio.com)
NEXT_PUBLIC_APP_URL=


# ─── EMAIL / TIENDA (opcionales) ──────────────────────────────────────
# RESEND_FROM_NAME=
# ADMIN_EMAIL=                        # a dónde llegan los avisos al admin (si no, usa RESEND_FROM_EMAIL)
# NEXT_PUBLIC_TIENDA_NOMBRE=
# NEXT_PUBLIC_WHATSAPP_NUMBER=        # sin + ni espacios
# NEXT_PUBLIC_WHATSAPP_MESSAGE=
# NEXT_PUBLIC_WHATSAPP_GROUP_LINK=
# MAINTENANCE_MODE=                   # true = modo mantenimiento sin redeploy


# ─── MERCADO PAGO ─────────────────────────────────────────────────────
# MERCADOPAGO_ACCESS_TOKEN=
# NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_WEBHOOK_SECRET=         # valida la firma del webhook. En producción tiene que estar cargada
# MERCADOPAGO_WEBHOOK_ENABLED=        # true = permite pedidos con Mercado Pago (hoy deshabilitado si no es "true")


# ─── SEGURIDAD ────────────────────────────────────────────────────────

# Secrets de los endpoints /api/cron/* y /api/revalidate
# REVALIDATE_SECRET_TOKEN=            # crons externos (?secret=...) y /api/revalidate
# CRON_SECRET=                        # lo manda Vercel en los crons de vercel.json; tenés que crearla vos

# Cloudflare Turnstile (captcha en login, registro y contacto)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Antivirus de comprobantes (Cloudmersive). Si falta, se omite el escaneo
# CLOUDMERSIVE_API_KEY=

# Rate limit compartido entre instancias (Upstash Redis). Si faltan, se usa memoria local
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Admin
# ADMIN_REQUIRE_MFA=                  # true = los admins deben activar 2FA
# ADMIN_CSP_MODE=                     # report-only (por defecto) | off


# ─── NOTIFICACIONES ───────────────────────────────────────────────────

# Push web (generar las claves VAPID una sola vez)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=                        # mailto:tu@email.com
# NEXT_PUBLIC_ENABLE_DEV_PUSH=        # 1 = permite push en desarrollo (solo para pruebas)

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=


# ─── IA PARA PRODUCTOS (cadena de fallback: Gemini → Groq → OpenRouter) ──
# GEMINI_API_KEY=
# GEMINI_MODEL=                       # opcional, hay un valor por defecto
# GEMINI_MODEL_FALLBACK=              # opcional
# GROQ_API_KEY=
# GROQ_MODEL=                         # opcional
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=                   # opcional


# ─── META / FACEBOOK ──────────────────────────────────────────────────
# NEXT_PUBLIC_FB_PIXEL_ID=
# NEXT_PUBLIC_FB_APP_ID=
# FACEBOOK_APP_SECRET=                # para el webhook de deauthorize
# NEXT_PUBLIC_FB_DOMAIN_VERIFICATION=

# Sync del catálogo con Meta Commerce Manager (webhook Supabase → Meta)
# META_ACCESS_TOKEN=                  # token de System User (no vence)
# META_CATALOG_ID=
# SUPABASE_META_WEBHOOK_SECRET=
# META_GRAPH_API_VERSION=             # opcional (por defecto v23.0)


# ─── GOOGLE ───────────────────────────────────────────────────────────
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=      # Google Analytics (GA4)

# Merchant Center (cron /api/cron/sync-merchant)
# GOOGLE_MERCHANT_ACCOUNT_ID=
# GOOGLE_MERCHANT_DATA_SOURCE_ID=
# GOOGLE_MERCHANT_SITE_URL=           # opcional, URL pública del sitio
# GOOGLE_SERVICE_ACCOUNT_JSON=        # JSON de la cuenta de servicio, en una sola línea. NUNCA subirlo a git

# Google Customer Reviews
# NEXT_PUBLIC_GOOGLE_MERCHANT_ID=     # opcional, hay un valor por defecto
# NEXT_PUBLIC_GCR_BADGE=              # true = muestra la insignia (cuando Google ya aceptó el programa)
# NEXT_PUBLIC_GCR_DELIVERY_DAYS=      # días estimados de entrega (por defecto 3)


# ─── OTROS ────────────────────────────────────────────────────────────
# NEXT_PUBLIC_TAWKTO_PROPERTY_ID=     # chat de Tawk.to
# NEXT_PUBLIC_TAWKTO_WIDGET_ID=
# NEXT_PUBLIC_CLARITY_PROJECT_ID=     # Microsoft Clarity (opcional, hay un valor por defecto)
